            "Identity:\n",
            " [[1. 0. 0.]\n",
            " [0. 1. 0.]\n",
            " [0. 0. 1.]]\n",
            "A invese:\n",
            " [[ 1.         -1.        ]\n",
            " [-0.33333333  0.66666667]]\n",
            "A @ A_invese:\n",
            " [[ 1.00000000e+00 -1.11022302e-16]\n",
            " [ 5.55111512e-17  1.00000000e+00]]\n"
          ]
        }
      ],
      "source": [
        "import numpy as np\n",
        "I = np.eye(3)\n",
        "print(\"Identity:\\n\",I)\n",
        "\n",
        "A = np.array([[2,3],[1,3]])\n",
        "A_inv = np.linalg.inv(A)\n",
        "print(\"A invese:\\n\",A_inv)\n",
        "print(\"A @ A_invese:\\n\",A @ A_inv)\n"
      ]
    },
